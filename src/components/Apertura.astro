---
// SECCIÓN 1 · APERTURA (pantalla limpia)
// Preguntas que se revelan al hacer scroll. Sin menú, sin portada,
// sin autor, sin video: solo curiosidad.
---
<section class="apertura">
  <!-- Primera pantalla -->
  <div class="opening-screen flex flex-col items-center justify-center text-center px-6">
    <p class="q-main max-w-3xl">¿El tiempo existe…<br>o lo inventamos?</p>
    <div class="scroll-hint mt-16 flex flex-col items-center gap-2" style="color:rgba(255,255,255,0.4);">
      <span class="text-xs tracking-widest uppercase">Sigue bajando</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
    </div>
  </div>

  <!-- Descenso de preguntas -->
  <div class="max-w-3xl mx-auto px-6 pb-16 narrative-flow flex flex-col">
    <div class="reveal text-center">
      <p class="q-lead">Si existe…</p>
      <p class="q-main">¿Dónde está?</p>
    </div>

    <div class="reveal text-center">
      <p class="q-lead">Si está ahí…</p>
      <p class="q-main">¿Por qué nadie puede decir exactamente qué es?</p>
    </div>

    <div class="reveal text-center">
      <p class="q-lead">Y si nadie puede decir qué es…</p>
      <p class="q-main">¿Por qué organizamos toda nuestra vida alrededor de él?</p>
    </div>

    <div class="reveal text-center">
      <p class="q-lead">Pero… ¿y si es un invento?</p>
      <p class="q-main">¿Por qué todos vivimos como si fuera real?</p>
    </div>

    <div class="reveal text-center">
      <p class="q-main">¿Por qué envejecemos?</p>
      <p class="q-dots block mt-6">· · ·</p>
    </div>

    <div class="reveal text-center">
      <p class="q-main">¿Por qué todo cambia?</p>
    </div>
  </div>
</section>
