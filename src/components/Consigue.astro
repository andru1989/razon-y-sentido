---
// SECCIÓN 5 · CONSIGUE EL LIBRO (por país)
// Lee ?pais=co|mx|es|ar de la URL. Si no viene, intenta deducirlo del idioma
// del navegador (es-CO, es-MX…) y, si tampoco, muestra el selector.
// Por país: tarjeta destacada de compra directa del EPUB (Mercado Pago en
// Colombia, PayPal en el resto) + librerías externas para el libro físico.
import { PAISES, LIBRO, PAIS_POR_DEFECTO } from '../data/libro';

// El catálogo viaja al cliente como JSON: Alpine lo lee en componentes.ts.
const catalogoJson = JSON.stringify(PAISES).replace(/</g, '\\u003c');
---
<section id="consigue" class="story-section py-16 sm:py-20" style="background:var(--cream);"
  x-data="tiendas()" data-pais-defecto={PAIS_POR_DEFECTO}>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
    <div class="divider-gold"></div>
    <h2 class="font-display text-3xl sm:text-4xl mb-3" style="color:var(--navy);">Consigue el <span class="text-gold">libro</span></h2>
    <p class="text-base mb-8 max-w-md mx-auto" style="color:rgba(14,11,22,0.6);">
      Elige tu país. Compra el libro digital con descarga inmediata o consíguelo en tu librería preferida.
    </p>

    <!-- Aviso (p. ej. pago cancelado al volver de la pasarela) -->
    <div x-show="aviso" x-cloak class="mb-6 rounded-xl px-4 py-3 text-sm text-left"
      style="background:rgba(46,124,153,0.08); border:1px solid rgba(46,124,153,0.25); color:var(--navy);">
      <span x-text="aviso"></span>
    </div>

    <!-- Detectando el país (IP → zona horaria → idioma → país por defecto) -->
    <div x-show="!pais && detectando" class="py-10 flex flex-col items-center gap-3" aria-live="polite">
      <div class="spinner" style="width:32px;height:32px;border-width:3px;"></div>
      <p class="text-xs font-semibold uppercase tracking-widest" style="color:rgba(14,11,22,0.45);">Detectando tu país…</p>
    </div>

    <!-- Selector de país: solo si el visitante pulsa "Cambiar país" -->
    <div id="selector-pais" x-show="!pais && !detectando" x-cloak>
      <p class="text-sm font-bold uppercase tracking-widest mb-5" style="color:var(--gold-dark);">Elige tu país</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        <template x-for="(datos, codigo) in paises" :key="codigo">
          <button type="button" class="pais-btn" :data-pais="codigo" @click="elegir(codigo)">
            <span class="bandera" x-text="datos.bandera"></span>
            <span class="text-sm" x-text="datos.nombre"></span>
          </button>
        </template>
      </div>
    </div>

    <!-- País elegido -->
    <div x-show="pais" x-cloak>
      <div class="flex items-center justify-center gap-2 mb-8">
        <span class="text-2xl" x-text="paisActual.bandera"></span>
        <span class="font-display text-xl" style="color:var(--navy);" x-text="paisActual.nombre"></span>
        <button type="button" @click="cambiarPais()" class="text-xs font-semibold ml-2" style="color:var(--teal);">Cambiar país</button>
      </div>

      <!-- Compra directa del EPUB -->
      <template x-if="directo && directo.activo">
        <form class="compra-directa mb-8" @submit.prevent="comprar()" novalidate>
          <span class="compra-ribbon">Descarga inmediata</span>

          <div class="flex gap-4 items-start">
            <img src="/img/portada.jpeg" alt="" width="84" height="126" class="compra-thumb" loading="lazy" />
            <div class="flex-1 min-w-0">
              <p class="text-[11px] font-bold uppercase tracking-widest" style="color:var(--gold-dark);">Libro digital · EPUB</p>
              <p class="font-display text-lg leading-tight mt-1" style="color:var(--navy);">{LIBRO.titulo}</p>
              <p class="compra-precio mt-2"><span x-text="precioPartes[0]"></span><small x-show="precioPartes[1]" x-text="precioPartes[1]"></small></p>
              <ul class="mt-3 space-y-1.5">
                <li class="compra-check">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--gold-dark)" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                  <span>Lo descargas al instante y también te llega al correo</span>
                </li>
                <li class="compra-check">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--gold-dark)" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                  <span>Léelo en celular, tablet, Kindle o computador</span>
                </li>
                <li class="compra-check">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--gold-dark)" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                  <span x-text="'Pago seguro con ' + nombreProveedor + ' · ' + directo.medios"></span>
                </li>
              </ul>
            </div>
          </div>

          <div class="mt-5">
            <label for="correo-compra" class="block text-xs font-semibold mb-1.5" style="color:var(--navy);">¿A qué correo te enviamos el libro?</label>
            <input id="correo-compra" type="email" class="compra-input" placeholder="tu@correo.com"
              x-model="email" autocomplete="email" inputmode="email" required :aria-invalid="error ? 'true' : 'false'" />
            <!-- Campo trampa para bots: un humano nunca lo ve ni lo rellena -->
            <input type="text" name="sitio" x-model="sitio" tabindex="-1" autocomplete="off" aria-hidden="true"
              style="position:absolute; left:-9999px; width:1px; height:1px; opacity:0;" />
            <p x-show="error" x-cloak x-text="error" class="text-xs mt-1.5 font-medium" style="color:#C0392B;"></p>
          </div>

          <button type="submit" class="compra-btn gradient-cta mt-3" :disabled="enviando"
            data-checkout-btn>
            <span x-show="!enviando" class="flex flex-col items-center leading-tight">
              <span>Comprar libro digital</span>
              <span class="text-xs font-semibold opacity-90 tracking-wide" x-text="directo.precio_texto"></span>
            </span>
            <span x-show="enviando" x-cloak>Preparando tu pago…</span>
            <svg x-show="!enviando" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>

          <p class="text-[11px] text-center mt-3" style="color:rgba(14,11,22,0.5);">
            🔒 Pagas en la página oficial de <span x-text="nombreProveedor"></span>. Sin registro, sin suscripciones.
          </p>

          <div class="trust-row mt-4 pt-4 border-t border-amber-100">
            <div class="trust-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
              <span>Pago<br>protegido</span>
            </div>
            <div class="trust-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              <span>Entrega<br>inmediata</span>
            </div>
            <div class="trust-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
              <span>Ayuda por<br>WhatsApp</span>
            </div>
          </div>
        </form>
      </template>

      <p class="separador-o mb-5" x-show="directo && directo.activo">o consíguelo en librerías</p>

      <div class="grid gap-4 text-left mb-6">
        <template x-for="t in paisActual.tiendas" :key="t.nombre + t.formato">
          <a :href="t.url" target="_blank" rel="noopener" class="platform-card"
            :data-platform="t.nombre" :data-store="t.evento" :data-format="t.formato" :data-pais="pais">
            <span class="platform-logo"><img :src="'/img/logos/' + t.logo" :alt="t.nombre" loading="lazy"></span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <p class="font-semibold text-sm truncate" style="color:var(--navy);" x-text="t.nombre"></p>
                <span class="format-pill"
                  :class="t.formato==='digital' ? 'format-pill--digital' : (t.formato==='ambos' ? 'format-pill--ambos' : 'format-pill--fisico')"
                  x-text="t.formato==='digital' ? '📱 Digital' : (t.formato==='ambos' ? '📘📱 Físico y Digital' : '📘 Físico')"></span>
              </div>
              <p class="text-xs" style="color:rgba(14,11,22,0.5);" x-text="t.desc"></p>
            </div>
            <span class="text-gold text-sm font-bold flex-shrink-0">↗</span>
          </a>
        </template>
      </div>

      <p class="text-xs" style="color:rgba(14,11,22,0.45);">
        🔒 Compra directa y segura en la tienda oficial de cada plataforma.
      </p>
    </div>
  </div>

  <script is:inline type="application/json" id="catalogo-paises" set:html={catalogoJson}></script>
</section>
